<Window x:Class="AppSummoner.EditHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Hotkey" Height="550" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable Content Area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <!-- Application Info -->
                <GroupBox Header="Application" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Friendly Name:" Margin="0,0,0,5"/>
                        <TextBox x:Name="FriendlyNameTextBox" Padding="5"/>

                        <TextBlock Text="File Path:" Margin="0,10,0,5"/>
                        <TextBox x:Name="FilePathTextBox" Padding="5" IsReadOnly="True" Background="#F0F0F0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Modifiers -->
                <GroupBox Header="Modifiers (Optional)" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="LeftControlCheckBox" Content="Left Control" Margin="0,5"/>
                        <CheckBox x:Name="RightControlCheckBox" Content="Right Control" Margin="0,5"/>
                        <CheckBox x:Name="LeftShiftCheckBox" Content="Left Shift" Margin="0,5"/>
                        <CheckBox x:Name="RightShiftCheckBox" Content="Right Shift" Margin="0,5"/>
                        <CheckBox x:Name="LeftAltCheckBox" Content="Left Alt" Margin="0,5"/>
                        <CheckBox x:Name="RightAltCheckBox" Content="Right Alt" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Key -->
                <GroupBox Header="Key (Required)" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Click the box below and press the key you want to use:"
                                   Margin="0,0,0,5"
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="11"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Background="White">
                            <TextBox x:Name="KeyCaptureTextBox"
                                     Padding="10"
                                     IsReadOnly="True"
                                     PreviewKeyDown="KeyCaptureTextBox_PreviewKeyDown"
                                     GotFocus="KeyCaptureTextBox_GotFocus"
                                     Text="Click here and press a key..."
                                     Foreground="DarkGray"
                                     FontWeight="Bold"
                                     TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Behaviors -->
                <GroupBox Header="Behaviors" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="LaunchCheckBox" Content="Launch application if not running" Margin="0,5"/>
                        <CheckBox x:Name="FocusCheckBox" Content="Focus/bring to foreground if running" Margin="0,5"/>
                        <CheckBox x:Name="DismissCheckBox" Content="Dismiss if already focused" Margin="0,5" Checked="DismissCheckBox_Changed" Unchecked="DismissCheckBox_Changed"/>

                        <StackPanel x:Name="DismissTypePanel" Margin="20,5,0,0" IsEnabled="False">
                            <TextBlock Text="Dismiss Type:" Margin="0,0,0,5" FontSize="11"/>
                            <ComboBox x:Name="DismissTypeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="Minimize"/>
                                <ComboBoxItem Content="Hide"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons (Fixed at Bottom) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    MinWidth="80"/>
            <Button Content="Save"
                    Click="SaveButton_Click"
                    Padding="20,8"
                    MinWidth="80"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
