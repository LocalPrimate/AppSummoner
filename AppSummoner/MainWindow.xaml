<Window x:Class="AppSummoner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppSummoner"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="LightBlue">
        <Button 
            Click="AddRuneButton_Click" 
            Width="25"
            Height="25"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="64">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="50" />
                </Style>
            </Button.Resources>
            <Label FontSize="12">+</Label>
        </Button>
        
        <TextBlock
            x:Name="TextBlock_RuneAppName"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        >
            test
        </TextBlock>
        
        <Button 
            Click="InvokeRuneButton_Click" 
            Width="64"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="64">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Button.Resources>
            <Label FontSize="12">Start</Label>
        </Button>
        
        <Button 
            Click="InvokeRuneButton_Click" 
            Width="64"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="64">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Button.Resources>
            <Label FontSize="12">Start</Label>
        </Button>
        
    </Grid>
</Window>
