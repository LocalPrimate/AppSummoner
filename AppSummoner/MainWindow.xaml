<Window x:Class="AppSummoner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppSummoner"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="App Summoner" Height="450" Width="800"
        Icon="Resources/AppSummonerIcon.png"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="App Summoner"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="ShowWindow_Click" FontWeight="Bold"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="ExitApp_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <TabControl>
        <!-- Runes Tab -->
        <TabItem Header="Runes">
            <Grid Background="White" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                    Configured Runes
                </TextBlock>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HotkeysItemsControl" ItemsSource="{Binding Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,10" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Checked="HotkeyToggle_Changed"
                                                  Unchecked="HotkeyToggle_Changed"
                                                  Tag="{Binding}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  ToolTip="Enable/Disable this hotkey"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding AppInfo.FriendlyName}"/>
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="0,2,0,0">
                                                <Run Text="Hotkey: "/>
                                                <Run FontWeight="SemiBold" Text="{Binding Hotkey.Modifiers, Mode=OneWay}"/>
                                                <Run Text=" + "/>
                                                <Run FontWeight="SemiBold" Text="{Binding Hotkey.Keycode, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="DarkGray" Text="{Binding AppInfo.FilePath}" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,10,0">
                                                    <Run Text="Launch:"/>
                                                    <Run Text="{Binding Behaviour.Launch}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,10,0">
                                                    <Run Text="Focus:"/>
                                                    <Run Text="{Binding Behaviour.Focus}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,10,0">
                                                    <Run Text="Dismiss:"/>
                                                    <Run Text="{Binding Behaviour.Dismiss}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="Gray">
                                                    <Run Text="Type:"/>
                                                    <Run Text="{Binding Behaviour.DismissType}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Edit"
                                                Click="EditHotkey_Click"
                                                Tag="{Binding}"
                                                Padding="10,5"
                                                Margin="5,0"/>

                                        <Button Grid.Column="3" Content="Remove"
                                                Click="RemoveHotkey_Click"
                                                Tag="{Binding}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2"
                    Click="AddRuneButton_Click"
                    Content="Add New Rune"
                    HorizontalAlignment="Left"
                    Padding="15,10"/>
            </Grid>
        </TabItem>

        <!-- Focus Stealing Prevention Tab -->
        <TabItem Header="Focus Stealing Prevention">
            <Grid Background="White" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                    Blocked Executables
                </TextBlock>

                <ListBox x:Name="BlockedExecutablesListBox" Grid.Row="1" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Checked="BlockedExecutableToggle_Changed"
                                          Unchecked="BlockedExecutableToggle_Changed"
                                          Tag="{Binding}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          ToolTip="Enable/Disable blocking for this executable"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold" Text="{Binding ProcessName}"/>
                                    <TextBlock FontSize="10" Foreground="Gray" Text="{Binding FilePath}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Remove"
                                        Click="RemoveBlockedExecutable_Click"
                                        Tag="{Binding ProcessName}"
                                        Padding="10,5"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="Add Blocked Executable"
                        Click="AddBlockedExecutable_Click"
                        HorizontalAlignment="Left"
                        Padding="15,10"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
