<Window x:Class="AppSummoner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppSummoner"
        mc:Ignorable="d"
        Title="App Summoner" Height="450" Width="800">

    <TabControl>
        <!-- Runes Tab -->
        <TabItem Header="Runes">
            <Grid Background="White" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                    Configured Runes
                </TextBlock>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HotkeysItemsControl" ItemsSource="{Binding Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,10" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding AppInfo.FriendlyName}"/>
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="0,2,0,0">
                                                <Run Text="Hotkey: "/>
                                                <Run FontWeight="SemiBold" Text="{Binding Hotkey.Modifiers, Mode=OneWay}"/>
                                                <Run Text=" + "/>
                                                <Run FontWeight="SemiBold" Text="{Binding Hotkey.Keycode, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="DarkGray" Text="{Binding AppInfo.FilePath}" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,10,0">
                                                    <Run Text="Launch:"/>
                                                    <Run Text="{Binding Behaviour.Launch}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,10,0">
                                                    <Run Text="Focus:"/>
                                                    <Run Text="{Binding Behaviour.Focus}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,10,0">
                                                    <Run Text="Dismiss:"/>
                                                    <Run Text="{Binding Behaviour.Dismiss}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="Gray">
                                                    <Run Text="Type:"/>
                                                    <Run Text="{Binding Behaviour.DismissType}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Edit"
                                                Click="EditHotkey_Click"
                                                Tag="{Binding}"
                                                Padding="10,5"
                                                Margin="5,0"/>

                                        <Button Grid.Column="2" Content="Remove"
                                                Click="RemoveHotkey_Click"
                                                Tag="{Binding}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2"
                    Click="AddRuneButton_Click"
                    Content="Add New Rune"
                    HorizontalAlignment="Left"
                    Padding="15,10"/>
            </Grid>
        </TabItem>

        <!-- Focus Stealing Prevention Tab -->
        <TabItem Header="Focus Stealing Prevention">
            <Grid Background="White" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                    Blocked Executables
                </TextBlock>

                <ListBox x:Name="BlockedExecutablesListBox" Grid.Row="1" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="Bold" Text="{Binding ProcessName}"/>
                                    <TextBlock FontSize="10" Foreground="Gray" Text="{Binding FilePath}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Remove"
                                        Click="RemoveBlockedExecutable_Click"
                                        Tag="{Binding ProcessName}"
                                        Padding="10,5"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="Add Blocked Executable"
                        Click="AddBlockedExecutable_Click"
                        HorizontalAlignment="Left"
                        Padding="15,10"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
